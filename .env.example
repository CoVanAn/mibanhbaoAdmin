# Admin Environment Variables Template
# Copy this file to .env and fill in your values

# API Configuration
VITE_API_URL=http://localhost:4000
VITE_API_URL_PROD=https://your-production-api.com

# Admin App Configuration
VITE_APP_NAME=Mi Banh Bao Admin
VITE_APP_VERSION=1.0.0
VITE_ADMIN_TITLE=Admin Dashboard

# Localization
VITE_DEFAULT_LANGUAGE=vi
VITE_CURRENCY_NAME=VND
VITE_CURRENCY_SYMBOL=₫

# Authentication Configuration
VITE_ADMIN_TOKEN_KEY=admin_token
VITE_SESSION_TIMEOUT=3600000

# Google OAuth (Optional)
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Cloudinary Configuration (Optional)
VITE_CLOUDINARY_CLOUD_NAME=your-cloudinary-cloud-name

# Image Upload Configuration
VITE_MAX_FILE_SIZE=5242880
VITE_ALLOWED_FILE_TYPES=image/jpeg,image/png,image/jpg,image/webp
VITE_IMAGE_MAX_WIDTH=1920
VITE_IMAGE_MAX_HEIGHT=1080

# Table/List Configuration
VITE_ITEMS_PER_PAGE=10
VITE_MAX_ITEMS_PER_PAGE=100

# Feature Flags
VITE_ENABLE_ANALYTICS=false
VITE_ENABLE_NOTIFICATIONS=true
VITE_ENABLE_EXPORT=true

# Date Format
VITE_DATE_FORMAT=DD/MM/YYYY
