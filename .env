# API Configuration
VITE_API_URL=http://localhost:4000
VITE_API_URL_PROD=https://apisubject-backend.onrender.com

# Admin App Configuration
VITE_APP_NAME=Quản Lý Giao Hàng Đồ Ăn
VITE_APP_VERSION=1.0.0
VITE_ADMIN_TITLE=Bảng Điều Khiển Quản Trị

# Localization
VITE_DEFAULT_LANGUAGE=vi
VITE_CURRENCY_NAME=VND

# Authentication Configuration
VITE_ADMIN_TOKEN_KEY=admin_token
VITE_SESSION_TIMEOUT=3600000

# Image Upload Configuration
VITE_MAX_FILE_SIZE=5242880
VITE_ALLOWED_FILE_TYPES=image/jpeg,image/png,image/jpg
VITE_IMAGE_UPLOAD_URL=/api/food/add

# Table/List Configuration
VITE_ITEMS_PER_PAGE=10
VITE_MAX_ITEMS_PER_PAGE=100

# Feature Flags
VITE_ENABLE_ANALYTICS=true
VITE_ENABLE_NOTIFICATIONS=true
VITE_ENABLE_EXPORT=true

# Other Configuration
VITE_CURRENCY_SYMBOL=₫
VITE_DEFAULT_CATEGORY=Salad
VITE_DATE_FORMAT=DD/MM/YYYY
